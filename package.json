{
  "name": "apkflux",
  "version": "0.5.2",
  "private": true,
  "description": "A local Android APK inspection workbench",
  "author": "ApkFlux contributors",
  "main": "dist/main/index.cjs",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/build.mjs --dev",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:desktop": "node --test tests/desktop.mjs",
    "package:dir": "electron-builder --mac --arm64 --dir --publish never",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --publish never",
    "fixture": "node scripts/make-fixture.mjs",
    "test:decode": "node --test tests/decode.mjs",
    "test:edit": "node --test tests/edit.mjs",
    "test:native": "node --test tests/native.mjs",
    "test:stress": "node --test tests/stress.mjs"
  },
  "dependencies": {
    "crc-32": "^1.2.2",
    "electron-updater": "^6.8.11",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0",
    "element-plus": "^2.11.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "monaco-editor": "^0.55.0",
    "pinia": "^3.0.0",
    "playwright-core": "^1.56.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.0.0"
  },
  "build": {
    "appId": "dev.apkflux.desktop",
    "productName": "ApkFlux",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns"
    },
    "publish": null
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/wzebbin/ApkFlux.git"
  },
  "homepage": "https://wzebbin.github.io/ApkFlux/"
}
